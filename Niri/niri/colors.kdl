layout {
	background-color "#111416"

    focus-ring {
        active-color "#91cef7"
        inactive-color "#8a9298"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#91cef7"
        inactive-color "#8a9298"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#91cef7"
        inactive-color "#8a9298"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#91cef780"
    }
}

overview {
	backdrop-color "#111416"
}
